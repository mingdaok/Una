# Copy to .qq.env in this worktree. No secrets belong in version control.
UNA_QQ_ENABLED=false
UNA_QQ_BOT_ID=
UNA_QQ_ONEBOT_TOKEN=
UNA_QQ_ALLOWED_USERS=
UNA_QQ_ALLOWED_GROUPS=
UNA_QQ_ADMIN_IDS=
UNA_QQ_MAX_CONCURRENCY=2
UNA_QQ_QUEUE_LIMIT=100
# Temporary group test: 0 = normal model decision; 95 = 95% of eligible observation rounds.
# Keeps group enable switch, 15s evaluation interval, total quotas, and media limits.
UNA_QQ_TEST_REPLY_PERCENT=0
UNA_QQ_LLM_TIMEOUT_SECONDS=45
UNA_QQ_SEND_TIMEOUT_SECONDS=10
# Automatically resolve real public IPs over HTTPS when TUN returns Fake-IP.
UNA_QQ_MEDIA_DNS_FALLBACK=true
UNA_QQ_MEDIA_HOSTS=multimedia.nt.qq.com,gchat.qpic.cn,c2cpicdw.qpic.cn,multimedia.nt.qq.com.cn
# Use a separate JWT secret for this isolated runtime.
UNA_JWT_SECRET=

# Optional QQ-only model; blank keeps the web model.
UNA_QQ_LLM_BASE_URL=
UNA_QQ_LLM_MODEL=
UNA_QQ_LLM_API_KEY=

# Group behavior is stored per group in SQLite, configured in QQ Connection > Group behavior.
# Defaults: autonomous=true, stickers=true, collect=false, auto_accept=false,
# voice=true (explicit requests), autonomous_voice=false, context_count=60.
# Observe quiet 3s / hard 8s; evaluate at most once per 15s; autonomous 180s / 6 per hour.
# Stickers use UNA_QQ_MEDIA_DIR/stickers (runtime defaults to this worktree's .qq-data media).
# No new voice or embedding model download is required by these features.

# Optional absolute ffmpeg.exe path; matching ffprobe.exe must be in the same directory.
# Blank uses PATH. Existing ASR/TTS models are reused.
UNA_QQ_FFMPEG=
# Per-group timed tests in the admin panel override the legacy global probability.
# New timed test: 95%, 30 minutes; ending a group test does not change other groups.
